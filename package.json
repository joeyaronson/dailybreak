{
  "name": "dailybreak",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.worker.json && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "leaderboard:dev": "wrangler dev --config worker/wrangler.jsonc",
    "leaderboard:migrate:local": "wrangler d1 migrations apply dailybreak-scores --local --config worker/wrangler.jsonc",
    "leaderboard:migrate": "wrangler d1 migrations apply dailybreak-scores --remote --config worker/wrangler.jsonc",
    "leaderboard:deploy": "wrangler deploy --config worker/wrangler.jsonc"
  },
  "dependencies": {
    "obscenity": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.160.1"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
